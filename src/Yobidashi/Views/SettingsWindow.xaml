<Window x:Class="Yobidashi.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 - Yobidashi" Width="580" Height="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="設定" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>

            <!-- 一般 -->
            <TextBlock Text="一般" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
            <CheckBox Content="Windows 起動時に自動的に起動する"
                      IsChecked="{Binding AutoStart}" FontSize="13" Margin="0,0,0,6"/>

            <Separator Margin="0,16"/>

            <!-- 展開設定 -->
            <TextBlock Text="展開設定" FontSize="15" FontWeight="Bold" Margin="0,12,0,6"/>
            <TextBlock Text="トリガーキー（トリガー文字列の後に押すキー）" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
            <CheckBox Content="Space キーで展開" IsChecked="{Binding ExpandOnSpace}"
                      FontSize="13" Margin="0,0,0,6"/>
            <CheckBox Content="Tab キーで展開" IsChecked="{Binding ExpandOnTab}"
                      FontSize="13" Margin="0,0,0,6"/>

            <Separator Margin="0,16"/>

            <!-- 除外アプリ -->
            <TextBlock Text="除外アプリ" FontSize="15" FontWeight="Bold" Margin="0,12,0,6"/>
            <TextBlock Text="以下のアプリケーションでは展開機能を無効にします" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding NewExcludedProcess, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Text="{Binding NewExcludedDisplayName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" Margin="0,0,6,0"/>
                <Button Grid.Column="2" Content="追加" Padding="14,6" Click="AddExcludedApp_Click"/>
            </Grid>

            <ListBox ItemsSource="{Binding ExcludedApps}" MaxHeight="150"
                     BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ProcessName}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="削除" FontSize="11" Padding="8,3"
                                    Tag="{Binding}" Click="RemoveExcludedApp_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Separator Margin="0,16"/>

            <!-- ショートカット -->
            <TextBlock Text="ショートカット" FontSize="15" FontWeight="Bold" Margin="0,12,0,10"/>
            <TextBlock Text="検索ポップアップ" Style="{StaticResource SectionHeader}"/>
            <TextBox Text="{Binding SearchHotkey}" IsReadOnly="True"
                     Style="{StaticResource ModernTextBox}" Width="200" HorizontalAlignment="Left"/>

            <Separator Margin="0,16"/>

            <!-- データ管理 -->
            <TextBlock Text="データ管理" FontSize="15" FontWeight="Bold" Margin="0,12,0,10"/>
            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8">
                <Run Text="データベースの場所: "/>
                <Run Text="{Binding DatabasePath, Mode=OneWay}"/>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="エクスポート (JSON)" Padding="14,6" Margin="0,0,8,0"
                        Click="ExportButton_Click"/>
                <Button Content="インポート" Padding="14,6" Margin="0,0,8,0"
                        Click="ImportButton_Click"/>
                <Button Content="バックアップ" Padding="14,6"
                        Click="BackupButton_Click"/>
            </StackPanel>

            <Separator Margin="0,16"/>

            <!-- バージョン -->
            <TextBlock Text="Yobidashi（よびだし）" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBlock Text="バージョン 1.0.0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Text="日本語ユーザー向けテキスト展開アプリ" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

            <!-- 保存 -->
            <Button Content="設定を保存" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Click="SaveSettingsButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
