<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Yobidashi.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="設定 - Yobidashi"
    Width="600" Height="650">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="24">

            <TextBlock Text="設定" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8"/>

            <!-- 一般 -->
            <StackPanel Spacing="12">
                <TextBlock Text="一般" Style="{StaticResource SubtitleTextBlockStyle}"/>

                <ToggleSwitch Header="Windows 起動時に自動的に起動する"
                              IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}"
                              OnContent="有効" OffContent="無効"/>
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- 展開設定 -->
            <StackPanel Spacing="12">
                <TextBlock Text="展開設定" Style="{StaticResource SubtitleTextBlockStyle}"/>

                <TextBlock Text="トリガーキー（トリガー文字列の後に押すキー）" Opacity="0.7"/>

                <ToggleSwitch Header="Space キーで展開"
                              IsOn="{x:Bind ViewModel.ExpandOnSpace, Mode=TwoWay}"
                              OnContent="有効" OffContent="無効"/>

                <ToggleSwitch Header="Tab キーで展開"
                              IsOn="{x:Bind ViewModel.ExpandOnTab, Mode=TwoWay}"
                              OnContent="有効" OffContent="無効"/>
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- 除外アプリ -->
            <StackPanel Spacing="12">
                <TextBlock Text="除外アプリ" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="以下のアプリケーションでは展開機能を無効にします" Opacity="0.7"/>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" PlaceholderText="プロセス名 (例: KeePass)"
                             Text="{x:Bind ViewModel.NewExcludedProcess, Mode=TwoWay}"/>
                    <TextBox Grid.Column="1" PlaceholderText="表示名 (任意)"
                             Text="{x:Bind ViewModel.NewExcludedDisplayName, Mode=TwoWay}"/>
                    <Button Grid.Column="2" Content="追加" Click="AddExcludedApp_Click"/>
                </Grid>

                <ListView ItemsSource="{x:Bind ViewModel.ExcludedApps}" MaxHeight="200">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ExcludedApp">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind ProcessName}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center" Opacity="0.6"/>
                                <Button Grid.Column="2" Content="削除" Tag="{x:Bind}"
                                        Click="RemoveExcludedApp_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- ショートカット -->
            <StackPanel Spacing="12">
                <TextBlock Text="ショートカット" Style="{StaticResource SubtitleTextBlockStyle}"/>

                <TextBox Header="検索ポップアップ" IsReadOnly="True"
                         Text="{x:Bind ViewModel.SearchHotkey, Mode=TwoWay}"
                         PlaceholderText="Ctrl+Space"/>
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- データ管理 -->
            <StackPanel Spacing="12">
                <TextBlock Text="データ管理" Style="{StaticResource SubtitleTextBlockStyle}"/>

                <TextBlock Opacity="0.7">
                    <Run Text="データベースの場所: "/>
                    <Run Text="{x:Bind ViewModel.DatabasePath}"/>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="エクスポート (JSON)" Click="ExportButton_Click"/>
                    <Button Content="インポート" Click="ImportButton_Click"/>
                    <Button Content="バックアップ" Click="BackupButton_Click"/>
                </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- バージョン情報 -->
            <StackPanel Spacing="4">
                <TextBlock Text="Yobidashi（よびだし）" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="バージョン 1.0.0" Opacity="0.6"/>
                <TextBlock Text="日本語ユーザー向けテキスト展開アプリ" Opacity="0.6"/>
            </StackPanel>

            <!-- 保存ボタン -->
            <Button Content="設定を保存" Style="{StaticResource AccentButtonStyle}"
                    Click="SaveSettingsButton_Click" Padding="24,8"
                    HorizontalAlignment="Right"/>

        </StackPanel>
    </ScrollViewer>
</Window>
