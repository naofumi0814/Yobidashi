<Window x:Class="Yobidashi.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="入力" Width="380" Height="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" FontSize="13" Margin="0,0,0,10"/>
        <TextBox x:Name="InputBox" FontSize="13" Padding="8,6" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Padding="20,6" IsDefault="True" Click="OkButton_Click"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
            <Button Content="キャンセル" Padding="20,6" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
