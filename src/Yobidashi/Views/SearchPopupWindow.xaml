<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Yobidashi.Views.SearchPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="よびだし - 検索"
    Width="500" Height="400">

    <Grid Padding="16" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 検索ボックス -->
        <TextBox
            x:Name="SearchInput"
            Grid.Row="0"
            PlaceholderText="キーワードを入力..."
            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            FontSize="16"
            Padding="12,10"
            Margin="0,0,0,12"
            KeyDown="SearchInput_KeyDown"/>

        <!-- 検索結果一覧 -->
        <ListView
            x:Name="ResultsList"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Results}"
            SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}"
            SelectionMode="Single"
            DoubleTapped="ResultsList_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:Snippet">
                    <Grid Padding="8,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- トリガー文字列バッジ -->
                        <Border Grid.Column="0" Grid.RowSpan="2"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="6" Padding="10,6"
                            VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind TriggerText}" FontSize="13" FontWeight="SemiBold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>

                        <!-- タイトル -->
                        <TextBlock Grid.Column="1" Grid.Row="0"
                            Text="{x:Bind Title}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"/>

                        <!-- 本文プレビュー -->
                        <TextBlock Grid.Column="1" Grid.Row="1"
                            Text="{x:Bind Body}"
                            FontSize="12" Opacity="0.5"
                            MaxLines="1" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ヒント -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="0,8,0,0"
                    HorizontalAlignment="Center" Opacity="0.5">
            <TextBlock Text="↑↓ 選択" FontSize="12"/>
            <TextBlock Text="Enter 挿入" FontSize="12"/>
            <TextBlock Text="Esc 閉じる" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
