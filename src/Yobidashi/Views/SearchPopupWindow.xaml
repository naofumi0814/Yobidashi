<Window x:Class="Yobidashi.Views.SearchPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="よびだし - 検索" Width="500" Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Border Background="White" CornerRadius="12" Margin="8"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="#000"/>
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 検索ボックス -->
            <TextBox x:Name="SearchInput" Grid.Row="0"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16" Padding="12,10"
                     BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2"
                     Margin="0,0,0,12"
                     KeyDown="SearchInput_KeyDown">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- 結果一覧 -->
            <ListBox x:Name="ResultsList" Grid.Row="1"
                     ItemsSource="{Binding Results}"
                     SelectedIndex="{Binding SelectedIndex}"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="ResultsList_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,10" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Column="0" Grid.RowSpan="2"
                                        Background="{StaticResource AccentBadgeBrush}"
                                        CornerRadius="6" Padding="10,6" Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TriggerText}" FontSize="13"
                                               FontWeight="SemiBold" Foreground="White"/>
                                </Border>

                                <TextBlock Grid.Column="1" Grid.Row="0"
                                           Text="{Binding Title}" FontWeight="SemiBold"
                                           FontSize="13" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="1" Grid.Row="1"
                                           Text="{Binding Body}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxHeight="16"
                                           Margin="0,3,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ヒント -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                <TextBlock Text="↑↓ 選択" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                <TextBlock Text="Enter 挿入" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                <TextBlock Text="Esc 閉じる" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
