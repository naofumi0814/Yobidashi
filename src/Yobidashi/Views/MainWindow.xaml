<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Yobidashi.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Yobidashi - よびだし"
    Width="1100" Height="700"
    MinWidth="800" MinHeight="500">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー: 検索バー + コントロール -->
        <Grid Grid.Row="0" Padding="16,12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="定型文を検索..."
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ToggleButton
                    x:Name="PauseButton"
                    IsChecked="{x:Bind ViewModel.IsPaused, Mode=TwoWay}"
                    ToolTipService.ToolTip="一時停止"
                    Click="PauseButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE769;" FontSize="14"/>
                        <TextBlock Text="一時停止" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <Button Click="SettingsButton_Click" ToolTipService.ToolTip="設定">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE713;" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- メインコンテンツ: 3カラムレイアウト -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- 左: カテゴリ一覧 -->
            <Grid Grid.Column="0" Padding="12" Background="{ThemeResource LayerFillColorAltBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="カテゴリ" Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="4,0,0,8"/>

                <ListView Grid.Row="1"
                    x:Name="CategoryList"
                    ItemsSource="{x:Bind ViewModel.Categories}"
                    SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" Padding="4,6"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button Grid.Row="2" Content="+ カテゴリ追加" HorizontalAlignment="Stretch"
                        Margin="0,8,0,0" Click="AddCategoryButton_Click"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" ResizeBehavior="PreviousAndNext"
                          Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- 中央: 定型文一覧 -->
            <Grid Grid.Column="2" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="定型文" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8"/>
                    <Button Grid.Column="1" Click="NewSnippetButton_Click" ToolTipService.ToolTip="新規作成">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE710;" FontSize="14"/>
                    </Button>
                </Grid>

                <!-- 並び替え -->
                <ComboBox Grid.Row="1" Header="並び替え" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                          SelectedIndex="0" SelectionChanged="SortComboBox_SelectionChanged">
                    <ComboBoxItem Content="更新日順" Tag="updated"/>
                    <ComboBoxItem Content="使用頻度順" Tag="use_count"/>
                    <ComboBoxItem Content="最近使った順" Tag="last_used"/>
                    <ComboBoxItem Content="タイトル順" Tag="title"/>
                    <ComboBoxItem Content="トリガー順" Tag="trigger"/>
                </ComboBox>

                <ListView Grid.Row="2"
                    x:Name="SnippetList"
                    ItemsSource="{x:Bind ViewModel.Snippets}"
                    SelectedItem="{x:Bind ViewModel.SelectedSnippet, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Snippet">
                            <Grid Padding="4,8" ColumnSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                    Text="{x:Bind Title}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"/>

                                <Border Grid.Row="0" Grid.Column="1"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    Visibility="{x:Bind IsEnabled}">
                                    <TextBlock Text="{x:Bind TriggerText}" FontSize="11"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Border>

                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                    Text="{x:Bind Body}"
                                    FontSize="12" Opacity="0.6"
                                    MaxLines="1" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <GridSplitter Grid.Column="3" Width="1" ResizeBehavior="PreviousAndNext"
                          Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- 右: 詳細編集フォーム -->
            <ScrollViewer Grid.Column="4" Padding="16">
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}">

                    <TextBlock Text="定型文の編集" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4"/>

                    <TextBox Header="タイトル" PlaceholderText="定型文の名前"
                             Text="{x:Bind ViewModel.EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox Header="トリガー文字列" PlaceholderText="例: じゅうしょ, しょめい"
                             Text="{x:Bind ViewModel.EditTrigger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <ComboBox Header="カテゴリ" ItemsSource="{x:Bind ViewModel.Categories}"
                              SelectedItem="{x:Bind ViewModel.EditCategory, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"/>

                    <TextBox Header="タグ（カンマ区切り）" PlaceholderText="ビジネス, メール"
                             Text="{x:Bind ViewModel.EditTags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox Header="メモ" PlaceholderText="この定型文についてのメモ"
                             Text="{x:Bind ViewModel.EditMemo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <ToggleSwitch Header="有効" IsOn="{x:Bind ViewModel.EditIsEnabled, Mode=TwoWay}"
                                  OnContent="有効" OffContent="無効"/>

                    <TextBox Header="本文" PlaceholderText="展開する本文を入力&#x0a;変数: {{date}} {{time}} {{clipboard}} {{cursor}}"
                             Text="{x:Bind ViewModel.EditBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="150" MaxHeight="300"/>

                    <!-- プレビュー -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="プレビュー（変数展開後）" Style="{StaticResource CaptionTextBlockStyle}"
                                   Margin="0,0,0,4" Opacity="0.6"/>
                        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="4" Padding="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" MinHeight="80">
                            <TextBlock Text="{x:Bind ViewModel.PreviewText, Mode=OneWay}"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        </Border>
                    </Grid>

                    <!-- ボタン -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="保存" Style="{StaticResource AccentButtonStyle}"
                                Click="SaveButton_Click" HorizontalAlignment="Left" Padding="24,8"/>

                        <Button Grid.Column="1" Content="削除" Click="DeleteButton_Click"
                                HorizontalAlignment="Right" Padding="24,8">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="#E74C3C"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C0392B"/>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ステータスバー -->
        <Grid Grid.Row="2" Padding="12,6" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center">
                <Run Text="定型文: "/>
                <Run Text="{x:Bind ViewModel.SnippetCount, Mode=OneWay}"/>
                <Run Text="件"/>
            </TextBlock>

            <Rectangle Grid.Column="1" Width="1" Height="14" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                       Margin="12,0"/>

            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       VerticalAlignment="Center" Opacity="0.7"/>
        </Grid>
    </Grid>
</Window>
