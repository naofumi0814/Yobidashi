<Window x:Class="Yobidashi.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yobidashi - よびだし" Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        Background="{StaticResource SurfaceBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="0"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,12,0">
                    <TextBox.Tag>定型文を検索...</TextBox.Tag>
                </TextBox>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton x:Name="PauseButton" Padding="10,6"
                                  IsChecked="{Binding IsPaused}"
                                  Click="PauseButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏸" Margin="0,0,6,0"/>
                            <TextBlock Text="一時停止"/>
                        </StackPanel>
                    </ToggleButton>

                    <Button Content="⚙" Margin="8,0,0,0" Padding="10,6"
                            Click="SettingsButton_Click" ToolTip="設定"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- メインコンテンツ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- 左: カテゴリ -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="カテゴリ" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Margin="4,0,0,10"/>

                    <ListBox Grid.Row="1" x:Name="CategoryList"
                             ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             BorderThickness="0" Background="Transparent"
                             Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Padding="8,6" FontSize="13"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="＋ カテゴリ追加" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" Padding="8,6"
                            Click="AddCategoryButton_Click"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="#E2E8F0"
                          Cursor="SizeWE" ResizeBehavior="PreviousAndNext"/>

            <!-- 中央: 定型文一覧 -->
            <Grid Grid.Column="2" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="定型文" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="＋" FontSize="16" Padding="8,2"
                            Click="NewSnippetButton_Click" ToolTip="新規作成"/>
                </Grid>

                <ComboBox Grid.Row="1" Margin="0,0,0,8" SelectedIndex="0"
                          SelectionChanged="SortComboBox_SelectionChanged" FontSize="12">
                    <ComboBoxItem Content="更新日順" Tag="updated"/>
                    <ComboBoxItem Content="使用頻度順" Tag="use_count"/>
                    <ComboBoxItem Content="最近使った順" Tag="last_used"/>
                    <ComboBoxItem Content="タイトル順" Tag="title"/>
                    <ComboBoxItem Content="トリガー順" Tag="trigger"/>
                </ComboBox>

                <ListBox Grid.Row="2" x:Name="SnippetList"
                         ItemsSource="{Binding Snippets}"
                         SelectedItem="{Binding SelectedSnippet}"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,10" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Title}" FontWeight="SemiBold"
                                               FontSize="13" TextTrimming="CharacterEllipsis"/>

                                    <Border Grid.Row="0" Grid.Column="1"
                                            Background="{StaticResource AccentBadgeBrush}"
                                            CornerRadius="4" Padding="8,2" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding TriggerText}" FontSize="11"
                                                   Foreground="White"/>
                                    </Border>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                               Text="{Binding Body}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxHeight="16"
                                               Margin="0,4,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="#E2E8F0"
                          Cursor="SizeWE" ResizeBehavior="PreviousAndNext"/>

            <!-- 右: 編集フォーム -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,12" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock Text="定型文の編集" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="タイトル" Style="{StaticResource SectionHeader}"/>
                    <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="トリガー文字列" Style="{StaticResource SectionHeader}"/>
                    <TextBox Text="{Binding EditTrigger, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="カテゴリ" Style="{StaticResource SectionHeader}"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding EditCategory}"
                              Margin="0,0,0,12" Padding="8,6" FontSize="13"/>

                    <TextBlock Text="タグ（カンマ区切り）" Style="{StaticResource SectionHeader}"/>
                    <TextBox Text="{Binding EditTags, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="メモ" Style="{StaticResource SectionHeader}"/>
                    <TextBox Text="{Binding EditMemo, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                    <CheckBox Content="有効" IsChecked="{Binding EditIsEnabled}"
                              FontSize="13" Margin="0,0,0,12"/>

                    <TextBlock Text="本文" Style="{StaticResource SectionHeader}"/>
                    <TextBox Text="{Binding EditBody, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="120" MaxHeight="250"
                             Style="{StaticResource ModernTextBox}"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="プレビュー（変数展開後）" Style="{StaticResource SectionHeader}"/>
                    <Border Background="#F8FAFC" CornerRadius="6" Padding="12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            MinHeight="60" Margin="0,0,0,16">
                        <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap"
                                   FontSize="13" Foreground="{StaticResource TextBrush}"/>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="保存" Style="{StaticResource PrimaryButton}"
                                Click="SaveButton_Click"/>
                        <Button Grid.Column="2" Content="削除" Style="{StaticResource DangerButton}"
                                Click="DeleteButton_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ステータスバー -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="定型文: "/>
                    <Run Text="{Binding SnippetCount}"/>
                    <Run Text="件"/>
                </TextBlock>
                <Rectangle Width="1" Height="12" Fill="{StaticResource BorderBrush}" Margin="12,0"/>
                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
